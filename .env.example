# Desarrollo local (DEBUG por defecto es false; actívalo explícitamente en dev)
AHHH_DEBUG=true
AHHH_SECRET_KEY=cambia-esta-clave-en-cualquier-entorno-compartido
AHHH_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],100.95.61.46
AHHH_TIME_ZONE=Europe/Madrid

# Rate limiting de login y registros (formato django-ratelimit: "5/h", "10/5m", ...)
AHHH_AUTH_RATE=5/h

# Pasarela de pagos
# AHHH_PAYMENT_GATEWAY  Pasarela activa. 'dummy' es para desarrollo (no cobra nada) y
#                       es la unica disponible por ahora. Cuando se elija una pasarela
#                       real, se pondra aqui su nombre (ej. 'stripe').
# AHHH_PAYMENT_MODE     Modo de operacion: 'test' (sandbox, sin cobros reales) o
#                       'live' (produccion, cobros reales). Por defecto 'test'.
# AHHH_PAYMENT_GATEWAY=dummy
# AHHH_PAYMENT_MODE=test
#
# IMPORTANTE: las claves reales de la pasarela (secret key, webhook secret, etc.)
# se configuran UNICAMENTE en tu .env local o del servidor. NUNCA se suben al
# repositorio ni a .env.example.
# Ejemplo (cuando exista una pasarela real):
# AHHH_PAYMENT_GATEWAY=stripe
# AHHH_PAYMENT_MODE=test
# AHHH_STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# AHHH_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
#
# AHHH_PUBLIC_BASE_URL  Origen publico canonico (sin barra final). Es la URL que
#                       la pasarela usara para llamar al webhook de pagos
#                       (https://dominio/pagos/webhook/). En desarrollo puede
#                       dejarse vacio.
# AHHH_PUBLIC_BASE_URL=https://www.ahhh-ibiza.com

# PostgreSQL (Docker) - usadas por docker-compose.yml
AHHH_POSTGRES_DB=ahhh_db
AHHH_POSTGRES_USER=ahhh_user
AHHH_POSTGRES_PASSWORD=cambia-esta-contrasena
AHHH_DB_HOST=127.0.0.1
AHHH_DB_PORT=5432

# Superadmin (ajusta antes de compartir el archivo)
AHHH_ADMIN_USERNAME=Patricia
AHHH_ADMIN_PASSWORD=cambia-esta-contrasena

# Gunicorn (solo contenedor app de docker compose)
# AHHH_GUNICORN_WORKERS=3

# Produccion HTTPS
# AHHH_DEBUG=false
# AHHH_ALLOWED_HOSTS=ahhh-ibiza.com,www.ahhh-ibiza.com
# AHHH_CSRF_TRUSTED_ORIGINS=https://ahhh-ibiza.com,https://www.ahhh-ibiza.com
# AHHH_SECURE_SSL_REDIRECT=true
# AHHH_SECURE_HSTS_SECONDS=31536000
# AHHH_REDIS_URL=redis://redis:6379/1
#
# AHHH_DOMAIN  Dominio publico principal (sin www ni https://). Lo usan los
#              scripts de despliegue HTTPS (deploy/install_https.sh y el timer
#              de renovacion) para emitir y renovar el certificado de
#              Let's Encrypt. El certificado se busca en /etc/letsencrypt/live/
#              con este nombre (mismo dominio que en deploy/nginx/ahhh.conf).
# AHHH_DOMAIN=ahhh-ibiza.com

# Copias de seguridad (deploy/backup.sh)
# AHHH_BACKUP_RETENTION_DAYS  Cuantos dias se conservan las copias diarias de la
#                             base y la media antes de rotarse. El archivo
#                             mensual (1er dia de cada mes) nunca se rota.
# AHHH_BACKUP_RETENTION_DAYS=14

# Consumo diario de Tangas (deploy/install_charge_timer.sh)
# AHHH_TANGAS_CHARGE_HOUR  Hora del cobro diario del plan de los anuncios
#                          (formato HH:MM, zona AHHH_TIME_ZONE). El instalador
#                          genera el timer de systemd con esta hora; por
#                          defecto 02:45 (antes del backup de las 03:15 y de la
#                          renovacion del certificado de las 04:30).
# AHHH_TANGAS_CHARGE_HOUR=02:45

# Correo (SMTP) - recuperacion de contrasena y notificaciones
# AHHH_EMAIL_HOST  Servidor SMTP de salida. Vacío usa el backend de consola
#                  (los correos se imprimen en el servidor; util en desarrollo).
#                  En produccion rellenar con los datos del proveedor (p. ej.
#                  el correo del hosting, SendGrid, Brevo, ...).
# AHHH_EMAIL_HOST=smtp.tu-proveedor.com
# AHHH_EMAIL_PORT=587
# AHHH_EMAIL_HOST_USER=usuario-del-smtp
# AHHH_EMAIL_HOST_PASSWORD=contrasena-del-smtp
# AHHH_EMAIL_USE_TLS=true
# AHHH_DEFAULT_FROM_EMAIL=Ahhh! Ibiza <noreply@ahhh-ibiza.com>
