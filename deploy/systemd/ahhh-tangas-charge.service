[Unit]
Description=Cobro diario de Tangas de los planes de anuncios de Ahhh! Ibiza
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ahhh-ibiza
ExecStart=/usr/bin/docker compose exec -T app python manage.py consume_plan_tangas
